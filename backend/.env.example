# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- news providers ---
# https://newsdata.io/  (free tier ~200 req/day)
NEWSDATA_API_KEY=
# https://gnews.io/     (free tier ~100 req/day)
GNEWS_API_KEY=
# https://newsapi.org/  (free tier ~100 req/day, dev use only)
# Accepted as either NEWS_API_KEY or NEWSAPI_API_KEY.
NEWS_API_KEY=

# --- optional: summarization (currently unused) ---
OPENAI_API_KEY=

# --- storage: Neon Postgres ---
# Neon dashboard -> Connection Details -> "Connection string".
# Use the POOLED host (contains "-pooler") for the app.
# Driver must be postgresql+asyncpg, and Neon requires TLS.
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?ssl=require
DATABASE_URL=

# --- app ---
CORS_ORIGINS=http://localhost:3000
